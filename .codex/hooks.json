{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/framework/runtime.py\" context",
            "timeout": 5,
            "statusMessage": "Loading phase context"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/framework/runtime.py\" session-end",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
